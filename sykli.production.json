{
  "schema": "sykli-production-contract.v1",
  "targets": {
    "sykli": {
      "inputs": {
        "source": {
          "paths": [
            ".github/workflows/ci.yml",
            "AGENTS.md",
            "CHANGELOG.md",
            "CLAUDE.md",
            "CONTRIBUTING.md",
            "Cargo.lock",
            "Cargo.toml",
            "GEMINI.md",
            "LICENSE",
            "README.md",
            "SECURITY.md",
            "action.yml",
            "action/binary.sh",
            "action/plan.sh",
            "action/summary.sh",
            "action/verify.sh",
            "docs/agents.md",
            "docs/verification/DeliveryCrash.lean",
            "docs/verification/TestStdin.lean",
            "docs/verification/test-stdin.md",
            "tests/stdin.rs",
            "tests/support/stdio.rs",
            "docs/verification/DeliveryInventory.lean",
            "docs/verification/delivery-inventory.md",
            "docs/verification/delivery-crash.md",
            "install.sh",
            "src/canonical.rs",
            "src/journal.rs",
            "src/runs.rs",
            "src/worktree_cache.rs",
            "src/hook.rs",
            "src/init.rs",
            "src/lib.rs",
            "src/main.rs",
            "src/production/contract.rs",
            "src/production/discovery.rs",
            "src/production/mod.rs",
            "src/production/store.rs",
            "src/repo.rs",
            "sykli.json",
            "sykli.lock",
            "tests/boundary.rs",
            "tests/cli.rs",
            "tests/external.rs",
            "tests/facts.rs",
            "tests/forgery.rs",
            "tests/runs.rs",
            "tests/worktree_cache.rs",
            "tests/fixtures/production/main.rs",
            "tests/git_calls.rs",
            "tests/init.rs",
            "tests/production.rs",
            "tests/qa/sykli.json",
            "tests/snapshot.rs",
            "examples/ci_shadow.rs",
            "tests/ci_shadow.rs",
            "docs/ci-shadow.md",
            "src/production/delivery.rs",
            "tests/delivery.rs"
          ],
          "type": {
            "kind": "source-tree"
          }
        }
      },
      "operations": {
        "build": {
          "inputs": {
            "source": {
              "expects": {
                "kind": "source-tree"
              },
              "from": {
                "kind": "target-input",
                "port": "source"
              }
            }
          },
          "kind": "transform",
          "outputs": {
            "executable": {
              "collect": "app",
              "type": {
                "architecture": "aarch64",
                "format": "macho",
                "kind": "executable"
              },
              "validator": "builtin.v1"
            }
          },
          "reuse": "never",
          "run": "cd \"$SYKLI_INPUT_source\" && cargo build --offline --locked --package 'sykli' --target 'aarch64-apple-darwin' --target-dir \"$SYKLI_OUTPUT/target\" --release --bin 'sykli' && cp \"$SYKLI_OUTPUT/target\"/'aarch64-apple-darwin/release/sykli' \"$SYKLI_OUTPUT/app\""
        },
        "smoke_test": {
          "assertion": "declared smoke command succeeds for the collected executable",
          "inputs": {
            "executable": {
              "expects": {
                "architecture": "aarch64",
                "format": "macho",
                "kind": "executable"
              },
              "from": {
                "kind": "operation-output",
                "operation": "build",
                "port": "executable"
              }
            }
          },
          "kind": "check",
          "reuse": "never",
          "run": "\"$SYKLI_INPUT_executable\" produce --help",
          "subject_input": "executable"
        },
        "workspace_tests": {
          "assertion": "Cargo workspace unit, integration and doc tests pass, with Go available for Go production tests",
          "inputs": {
            "source": {
              "expects": {
                "kind": "source-tree"
              },
              "from": {
                "kind": "target-input",
                "port": "source"
              }
            }
          },
          "kind": "check",
          "reuse": "never",
          "run": "cd \"$SYKLI_INPUT_source\" && cargo test --offline --locked --workspace --target 'aarch64-apple-darwin' --target-dir \"$SYKLI_OUTPUT/target\"",
          "subject_input": "source"
        }
      },
      "products": {
        "sykli": {
          "kind": "operation-output",
          "operation": "build",
          "port": "executable"
        }
      },
      "profile": {
        "kind": "local-shell.v1",
        "tools": [
          "cargo",
          "rustc",
          "go"
        ]
      },
      "required_checks": [
        "workspace_tests",
        "smoke_test"
      ]
    }
  }
}
