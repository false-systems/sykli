{
  "schema": "sykli-contract.v1",
  "tasks": [
    {
      "name": "fmt",
      "run": "cargo fmt --check",
      "inputs": [
        "Cargo.toml",
        "src/init.rs",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "tests/init.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs",
        "mcp/Cargo.toml",
        "mcp/src/main.rs",
        "mcp/tests/mcp.rs",
        "src/production/contract.rs",
        "src/production/mod.rs",
        "src/production/store.rs",
        "tests/production.rs",
        "examples/production/main.rs",
        "src/production/discovery.rs"
      ]
    },
    {
      "name": "installer",
      "run": "sh -n install.sh && code=0; sh install.sh ../bad >/dev/null 2>&1 || code=$?; test \"$code\" -eq 2",
      "inputs": [
        "install.sh"
      ]
    },
    {
      "name": "action",
      "run": "for script in action/*.sh; do sh -n \"$script\" || exit 1; grep -q \"$script\" action.yml || { echo \"unreferenced by action.yml: $script\" >&2; exit 1; }; done; missing=$(grep -o 'action/[a-z]*\\.sh' action.yml | sort -u | while read -r script; do [ -f \"$script\" ] || echo \"$script\"; done); test -z \"$missing\"",
      "inputs": [
        "action.yml",
        "action/binary.sh",
        "action/plan.sh",
        "action/summary.sh",
        "action/verify.sh"
      ]
    },
    {
      "name": "clippy",
      "run": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "after": [
        "fmt"
      ],
      "inputs": [
        "Cargo.lock",
        "Cargo.toml",
        "src/init.rs",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "tests/init.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs",
        "mcp/Cargo.toml",
        "mcp/src/main.rs",
        "mcp/tests/mcp.rs",
        "src/production/contract.rs",
        "src/production/mod.rs",
        "src/production/store.rs",
        "tests/production.rs",
        "examples/production/main.rs",
        "src/production/discovery.rs"
      ]
    },
    {
      "name": "test",
      "run": "cargo test --workspace --locked",
      "after": [
        "fmt"
      ],
      "inputs": [
        "Cargo.lock",
        "Cargo.toml",
        "src/init.rs",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "tests/init.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs",
        "mcp/Cargo.toml",
        "mcp/src/main.rs",
        "mcp/tests/mcp.rs",
        "src/production/contract.rs",
        "src/production/mod.rs",
        "src/production/store.rs",
        "tests/production.rs",
        "examples/production/main.rs",
        "src/production/discovery.rs"
      ]
    }
  ]
}
