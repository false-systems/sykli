{
  "schema": "sykli-contract.v1",
  "tasks": [
    {
      "name": "fmt",
      "run": "cargo fmt --check",
      "inputs": [
        "Cargo.toml",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs"
      ]
    },
    {
      "name": "installer",
      "run": "sh -n install.sh && code=0; sh install.sh ../bad >/dev/null 2>&1 || code=$?; test \"$code\" -eq 2",
      "inputs": ["install.sh"]
    },
    {
      "name": "clippy",
      "run": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "after": ["fmt"],
      "inputs": [
        "Cargo.lock",
        "Cargo.toml",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs"
      ]
    },
    {
      "name": "test",
      "run": "cargo test --workspace --locked",
      "after": ["fmt"],
      "inputs": [
        "Cargo.lock",
        "Cargo.toml",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "xtask/Cargo.toml",
        "xtask/src/main.rs"
      ]
    }
  ]
}
