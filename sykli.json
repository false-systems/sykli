{
  "schema": "sykli-contract.v1",
  "tasks": [
    {
      "name": "fmt",
      "run": "cargo fmt --check",
      "inputs": [
        "Cargo.toml",
        "rust-toolchain.toml",
        "src/init.rs",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "tests/init.rs",
        "src/production/contract.rs",
        "src/production/mod.rs",
        "src/production/store.rs",
        "tests/production.rs",
        "tests/fixtures/production/main.rs",
        "src/production/discovery.rs",
        "src/assessment.rs",
        "src/canonical.rs",
        "src/journal.rs",
        "src/runs.rs",
        "src/evidence.rs",
        "src/github.rs",
        "src/inspect.rs",
        "src/hook.rs",
        "src/repo.rs",
        "tests/assess.rs",
        "tests/assess_portable.rs",
        "examples/ci_shadow.rs",
        "tests/ci_shadow.rs",
        "tests/boundary.rs",
        "tests/external.rs",
        "tests/git_calls.rs",
        "tests/facts.rs",
        "tests/forgery.rs",
        "tests/runs.rs",
        "tests/snapshot.rs"
      ]
    },
    {
      "name": "installer",
      "run": "sh -n install.sh && code=0; sh install.sh ../bad >/dev/null 2>&1 || code=$?; test \"$code\" -eq 2",
      "inputs": [
        "install.sh"
      ]
    },
    {
      "name": "action",
      "run": "for script in action/*.sh; do sh -n \"$script\" || exit 1; grep -q \"$script\" action.yml || { echo \"unreferenced by action.yml: $script\" >&2; exit 1; }; done; missing=$(grep -o 'action/[a-z]*\\.sh' action.yml | sort -u | while read -r script; do [ -f \"$script\" ] || echo \"$script\"; done); test -z \"$missing\"",
      "inputs": [
        "action.yml",
        "action/binary.sh",
        "action/plan.sh",
        "action/summary.sh",
        "action/verify.sh"
      ]
    },
    {
      "name": "clippy",
      "run": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "after": [
        "fmt"
      ],
      "inputs": [
        "Cargo.lock",
        "rust-toolchain.toml",
        "Cargo.toml",
        "src/init.rs",
        "src/lib.rs",
        "src/main.rs",
        "tests/cli.rs",
        "tests/init.rs",
        "src/production/contract.rs",
        "src/production/mod.rs",
        "src/production/store.rs",
        "tests/production.rs",
        "tests/fixtures/production/main.rs",
        "src/production/discovery.rs",
        "src/assessment.rs",
        "src/canonical.rs",
        "src/journal.rs",
        "src/runs.rs",
        "src/evidence.rs",
        "src/github.rs",
        "src/inspect.rs",
        "src/hook.rs",
        "src/repo.rs",
        "tests/assess.rs",
        "tests/assess_portable.rs",
        "examples/ci_shadow.rs",
        "tests/ci_shadow.rs",
        "tests/boundary.rs",
        "tests/external.rs",
        "tests/git_calls.rs",
        "tests/facts.rs",
        "tests/forgery.rs",
        "tests/runs.rs",
        "tests/snapshot.rs"
      ]
    },
    {
      "name": "test",
      "run": "cargo test --workspace --locked",
      "after": [
        "fmt"
      ],
      "inputs": [
